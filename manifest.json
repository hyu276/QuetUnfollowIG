{
  "manifest_version": 3,
  "name": "QuetUnfollowIG",
  "version": "1.4.0",
  "description": "Cloud-backed Instagram follower/following snapshot tracker for any account visible to the current browser session.",
  "permissions": ["storage", "cookies"],
  "host_permissions": [
    "https://www.instagram.com/*",
    "https://zkrhwqgmynbbmoktokdq.supabase.co/*",
    "https://quet-unfollow-ig.vercel.app/*",
    "https://quet-unfollow-ig-hyu4.vercel.app/*",
    "http://localhost/*",
    "http://127.0.0.1/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://quet-unfollow-ig.vercel.app/*",
        "https://quet-unfollow-ig-hyu4.vercel.app/*",
        "http://localhost/*",
        "http://127.0.0.1/*"
      ],
      "js": ["web-bridge.js"],
      "run_at": "document_start"
    }
  ],
  "action": {
    "default_title": "QuetUnfollowIG",
    "default_popup": "popup.html"
  }
}
